# PostgreSQL — Prisma needs two URLs in production:
#   DATABASE_URL : POOLED connection (PgBouncer / Neon pooler) used at runtime.
#                  Required on serverless or you'll exhaust DB connections.
#   DIRECT_URL   : DIRECT (non-pooled) connection used only by migrations.
# Locally (no pooler) both can be the same value.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/savings?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/savings?schema=public"

# Cookie name for the Firebase session cookie
SESSION_COOKIE_NAME="sa_session"

# Optional: extra origins allowed to make state-changing API calls, comma-
# separated (e.g. "https://app.example.com"). Same-origin is always allowed;
# only set this if your API is called from a different origin you control.
ALLOWED_ORIGINS=""

# ── Firebase client SDK (browser) ──────────────────────────────
# From Firebase console → Project settings → General → Your apps → web app.
# These are NOT secret; they ship to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY="..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="..."
NEXT_PUBLIC_FIREBASE_APP_ID="1:...:web:..."

# ── Firebase Admin SDK (server, SECRET) ────────────────────────
# From Firebase console → Project settings → Service accounts →
# Generate new private key (downloads a JSON file).
FIREBASE_PROJECT_ID="your-project"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
# Keep the surrounding quotes and the literal \n escapes from the JSON file:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
